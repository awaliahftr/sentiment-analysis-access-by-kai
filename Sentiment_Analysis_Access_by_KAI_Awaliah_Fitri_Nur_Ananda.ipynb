from google_play_scraper import reviews, Sort
import pandas as pd
import time

app_id = 'com.kai.kaiticketing'
all_reviews = []
batch_size = 200
target = 12000
token = None

print('Mulai scraping ulasan KAI Access...')

while len(all_reviews) < target:
    result, token = reviews(
        app_id,
        lang='id',
        country='id',
        sort=Sort.NEWEST,
        count=batch_size,
        continuation_token=token
    )
    all_reviews.extend(result)
    print(f'Terkumpul: {len(all_reviews)} ulasan')
    if not token:
        break
    time.sleep(1)

df_raw = pd.DataFrame(all_reviews)[['userName', 'content', 'score', 'at']]
df_raw.columns = ['username', 'ulasan', 'rating', 'tanggal']
df_raw.to_csv('kai_access_raw.csv', index=False)
print(f'\nTotal data terkumpul: {len(df_raw)}')
